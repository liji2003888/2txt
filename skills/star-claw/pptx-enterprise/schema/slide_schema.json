{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/pptx-enterprise/slide_schema.json",
  "title": "OpenClaw Slide Schema",
  "description": "Slide JSON contract for OpenClaw pptx-enterprise. Adopted from PPTist's element model. Coordinates are pixels on a canvas (default 960x540).",
  "type": "object",
  "required": ["meta", "slides"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slide" }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "title": { "type": "string" },
        "width": { "type": "number", "default": 960 },
        "height": { "type": "number", "default": 540 },
        "theme": {
          "type": "object",
          "properties": {
            "fontName": { "type": "string" },
            "fontColor": { "type": "string" },
            "backgroundColor": { "type": "string" },
            "themeColors": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "slide": {
      "type": "object",
      "required": ["id", "elements"],
      "properties": {
        "id": { "type": "string" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
        "background": { "$ref": "#/$defs/background" },
        "remark": { "type": "string" }
      }
    },
    "background": {
      "type": "object",
      "properties": {
        "type": { "enum": ["solid", "image", "gradient"] },
        "color": { "type": "string" },
        "image": { "type": "string" },
        "imageSize": { "enum": ["cover", "contain", "repeat"] }
      }
    },
    "elementBase": {
      "type": "object",
      "required": ["id", "type", "left", "top", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "rotate": { "type": "number", "default": 0 },
        "groupId": { "type": "string" },
        "link": { "type": "object" },
        "name": { "type": "string" },
        "lock": { "type": "boolean" }
      }
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/imageElement" },
        { "$ref": "#/$defs/shapeElement" },
        { "$ref": "#/$defs/lineElement" },
        { "$ref": "#/$defs/tableElement" },
        { "$ref": "#/$defs/chartElement" },
        { "$ref": "#/$defs/latexElement" }
      ]
    },
    "textElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["content"],
          "properties": {
            "type": { "const": "text" },
            "content": { "type": "string", "description": "Rich text as HTML (PPTist-compatible)" },
            "defaultFontName": { "type": "string" },
            "defaultColor": { "type": "string" },
            "fontSize": { "type": "number" },
            "lineHeight": { "type": "number" },
            "wordSpace": { "type": "number" },
            "fill": { "type": "string" },
            "opacity": { "type": "number" },
            "bold": { "type": "boolean" },
            "italic": { "type": "boolean" },
            "align": { "enum": ["left", "center", "right"] },
            "valign": { "enum": ["top", "middle", "bottom"] }
          }
        }
      ]
    },
    "imageElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["src"],
          "properties": {
            "type": { "const": "image" },
            "src": { "type": "string" },
            "fixedRatio": { "type": "boolean" },
            "sizing": { "type": "object" }
          }
        }
      ]
    },
    "shapeElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["shapeType"],
          "properties": {
            "type": { "const": "shape" },
            "shapeType": { "enum": ["rect", "roundRect", "ellipse", "triangle", "trapezoid", "chevron", "diamond", "arrow", "star"] },
            "fill": { "type": "string" },
            "rectRadius": { "type": "number", "description": "Corner radius in inches for roundRect" },
            "outline": {
              "type": "object",
              "properties": {
                "color": { "type": "string" },
                "width": { "type": "number" }
              }
            },
            "fixedRatio": { "type": "boolean" },
            "text": {
              "type": "object",
              "properties": {
                "content": { "type": "string" },
                "defaultFontName": { "type": "string" },
                "defaultColor": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "lineElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["start", "end"],
          "properties": {
            "type": { "const": "line" },
            "start": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "end": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "color": { "type": "string" },
            "style": { "enum": ["solid", "dashed"] },
            "width": { "type": "number" }
          }
        }
      ]
    },
    "tableElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["data"],
          "properties": {
            "type": { "const": "table" },
            "data": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "text": { "type": "string" } }
                }
              }
            },
            "colWidths": { "type": "array", "items": { "type": "number" } },
            "rowHeights": { "type": "array", "items": { "type": "number" } },
            "theme": { "type": "object" }
          }
        }
      ]
    },
    "chartElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["chartType", "data"],
          "properties": {
            "type": { "const": "chart" },
            "chartType": { "enum": ["column", "bar", "line", "area", "pie", "donut", "doughnut", "radar", "scatter", "gauge"] },
            "data": {
              "type": "object",
              "required": ["series"],
              "properties": {
                "labels": { "type": "array", "items": { "type": "string" } },
                "series": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "values"],
                    "properties": {
                      "name": { "type": "string" },
                      "values": { "type": "array", "items": { "type": "number" } }
                    }
                  }
                }
              }
            },
            "themeColors": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "latexElement": {
      "allOf": [
        { "$ref": "#/$defs/elementBase" },
        {
          "type": "object",
          "required": ["path"],
          "properties": {
            "type": { "const": "latex" },
            "path": { "type": "string", "description": "Pre-rendered SVG path of the formula" },
            "latex": { "type": "string", "description": "Original LaTeX source" },
            "color": { "type": "string" }
          }
        }
      ]
    }
  }
}
